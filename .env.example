# ─── Quintal Brincante — variáveis de ambiente ───────────────────────────────
# Copie para .env.local (dev) e configure as mesmas na Vercel (produção).
# NUNCA commite valores reais. .env.local está no .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Local: os valores saem de `supabase status`.
# Produção: Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço (bypassa RLS). SÓ no servidor/worker. Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Worker agendado (pg_cron chama os endpoints) ─────────────────────────────
# Segredo que protege /api/worker/*. Gere um valor longo e aleatório.
CRON_SECRET=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# 'fake' = registra no banco, não envia (default).
# 'evolution' = Evolution API (não-oficial; decisão do dono 2026-07-05).
# 'cloud' = Meta Cloud API oficial (implementado, em stand-by).
WHATSAPP_PROVIDER=fake

# Provider 'evolution' (ver docs/WHATSAPP-EVOLUTION.md):
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Automação Railway (ativar somente após configurar o controlador e a migration).
PLAY_CONTROL_ENABLED=false
PLAY_CONTROL_URL=
PLAY_CONTROL_SECRET=

# Provider 'cloud' (Meta oficial — stand-by):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_LANG=pt_BR

# ── InfinitePay (Fase 1d — conciliação automática, atrás de flag) ────────────
INFINITEPAY_WEBHOOK_SECRET=
